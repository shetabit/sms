{
    "name": "shetabit/sms",
    "type": "library",
    "description": "Laravel Sms Gateway Integration Package",
    "keywords": [
        "shetabit",
        "gateway",
        "sms",
        "text message",
        "OTP message",
        "TTS message",
        "laravel sms package",
        "laravel sms gateway",
        "kavenegar",
        "smsir",
        "melipayamak",
        "farazsms",
        "tsms",
        "twilio",
        "clockwork",
        "textlocal",
        "linkmobility",
        "amazon sns"
    ],
    "homepage": "https://github.com/shetabit/sms",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahdi Khanzadi",
            "email": "khanzadimahdi@gmail.com",
            "homepage": "https://github.com/shetabit",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/notifications": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "ext-soap": "*",
        "aws/aws-sdk-php": "^3.340",
        "kavenegar/php": "^1.2.2",
        "larastan/larastan": "^3.10",
        "mediaburst/clockworksms": "^2.0",
        "melipayamak/php": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpcsstandards/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "rector/rector": "^2.6",
        "smsgatewayme/client": "^0.0.1",
        "twilio/sdk": "^8.3"
    },
    "suggest": {
        "ext-soap": "Needed by the tsms driver",
        "aws/aws-sdk-php": "Needed by the sns driver",
        "kavenegar/php": "Needed by the kavenegar driver",
        "mediaburst/clockworksms": "Needed by the clockwork driver",
        "melipayamak/php": "Needed by the melipayamak driver",
        "smsgatewayme/client": "Needed by the smsgatewayme driver",
        "twilio/sdk": "Needed by the twilio driver"
    },
    "autoload": {
        "psr-4": {
            "Shetabit\\Sms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shetabit\\Sms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "check-style": "phpcs",
        "fix-style": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "ci": [
            "@check-style",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite.",
        "test-coverage": "Run the test suite and report code coverage.",
        "check-style": "Check the coding style of src and tests.",
        "fix-style": "Fix the coding style of src and tests where possible.",
        "analyse": "Run static analysis on src and tests.",
        "rector": "Show the refactorings Rector would apply.",
        "ci": "Run every check the CI pipeline runs."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shetabit\\Sms\\Providers\\SmsServiceProvider"
            ],
            "aliases": {
                "Sms": "Shetabit\\Sms\\Facades\\Sms"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
